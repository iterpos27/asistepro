NODE_ENV=production
DATABASE_URL=postgresql://usuario:password@host:puerto/database
JWT_ACCESS_SECRET=coloca_un_secreto_largo
JWT_REFRESH_SECRET=coloca_otro_secreto_largo
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
RATE_LIMIT_MAX=1000
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_REGISTER_RATE_LIMIT_MAX=5
SLOW_REQUEST_MS=1500
CRON_SECRET=coloca_un_secreto_largo

# Si usas un frontend servido por este mismo servicio Railway, no necesitas
# definir VITE_API_URL: el frontend usara /api.
# Si separas frontend y backend, define:
# VITE_API_URL=https://TU_BACKEND.railway.app/api
# CORS_ORIGIN=https://TU_FRONTEND.railway.app
# FRONTEND_URL=https://TU_FRONTEND.railway.app

# Usa DB_SSL=true solo si tu PostgreSQL externo lo requiere.
# Railway Postgres por red interna normalmente no lo necesita.
# DB_SSL=true

# Para produccion usa supabase o s3. Deja database solo para pruebas o bajo volumen.
STORAGE_DRIVER=supabase
STORAGE_BUCKET=
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=
STORAGE_FORCE_PATH_STYLE=false
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
